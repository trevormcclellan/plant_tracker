# Either a full MongoDB connection URI or the three Atlas variables below.
MONGODB_URI=mongodb://localhost:27017
# MONGOUSER=
# MONGOPASSWORD=
# MONGOHOSTNAME=
PORT=4000
# Only needed when serving the UI and API from different origins.
# CLIENT_ORIGIN=https://plants.example.com
# DEV_CLIENT_ORIGIN=http://localhost:5173

# Exact IPs of proxies that connect to the API (comma-separated). Empty = no trust.
# For a tunnel via nginx, include nginx's IP and the tunnel connector's local IP.
# Use the addresses actually seen by the containers, not Cloudflare edge ranges.
TRUSTED_PROXIES=
